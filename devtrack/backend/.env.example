# Use the psycopg3 driver prefix. Host is "db" inside Docker Compose, "localhost" otherwise.
DATABASE_URL=postgresql+psycopg://devtrack:devtrack@localhost:5432/devtrack
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
