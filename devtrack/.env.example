# ---- Backend ----
DATABASE_URL=postgresql+psycopg://devtrack:devtrack@localhost:5432/devtrack
# Required, 32+ characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Frontend (build-time) ----
# URL the browser uses to reach the API. Leave empty in `npm run dev` to use the Vite proxy.
VITE_API_URL=

# ---- Docker Compose only ----
POSTGRES_DB=devtrack
POSTGRES_USER=devtrack
POSTGRES_PASSWORD=devtrack
SEED_DEMO_DATA=true
